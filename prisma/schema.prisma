// TBM Post Production — replaces the Master / Team / Brand Google Sheets.
// One Project row = one row of the old PROJECTS tab. Team tabs become the
// "My tasks" view (filtered by assignee), brand sheets become the client
// portal (filtered by brand). Nothing is copied between "sheets" any more —
// every view reads the same row, so the old onEdit/onChange sync loop and
// its undo/redo problems simply don't exist here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// TEAM REGISTRY
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   // ADMIN | MANAGER | MEMBER (see lib/constants.ts)
  department   String   // Creative | Editor | Production | Design Lead
  active       Boolean  @default(true) // Inactive = locked out (old "tab locked")
  createdAt    DateTime @default(now())

  assigned      Project[]      @relation("Assignee")
  createdTasks  Project[]      @relation("Creator")
  collaborating Project[]      @relation("Collaborators")
  notifications Notification[]
  updates       Update[]
}

// BRAND REGISTRY
model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  pocName   String?
  pocEmail  String?
  color     String   @default("#5b3fd1")
  createdAt DateTime @default(now())

  projects Project[]
  clients  Client[]
}

// Brand POC logins (replaces the per-brand Google Sheet)
model Client {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  brandId      String
  brand        Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
}

// PROJECTS (one row per deliverable)
model Project {
  id       String  @id @default(cuid())
  code     String  @unique // TBM-001
  title    String
  brandId  String?
  brand    Brand?  @relation(fields: [brandId], references: [id], onDelete: SetNull)
  type     String?
  platform String?
  dept     String  @default("Post Production")

  assigneeId String?
  assignee   User?   @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  priority   String  @default("Medium") // High | Medium | Low

  // Who added the task (team members can add their own tasks), and the
  // people collaborating on it — they can see it and get its comments.
  createdById   String?
  createdBy     User?   @relation("Creator", fields: [createdById], references: [id], onDelete: SetNull)
  collaborators User[]  @relation("Collaborators")

  onHold Boolean @default(false) // board column "On hold"

  externalDeadline DateTime?
  internalDeadline DateTime?

  briefStage     String @default("Not Started")
  scriptStage    String @default("Not Started")
  preProStage    String @default("Not Started")
  shootStatus    String @default("Not Started")
  editStatus     String @default("Not Started")
  revisionRound  Int    @default(0)
  clientReview   String @default("Pending")
  finalApproval  String @default("Pending")
  deliveryStatus String @default("Not Started")

  notes   String? // internal notes (admin/manager)
  context String? // "context from Sachin" — shown read-only to the assignee

  extDeadlineChanges Int @default(0)
  intDeadlineChanges Int @default(0)

  archived         Boolean   @default(false)
  closedAt         DateTime?
  statusChangedAt  DateTime  @default(now()) // last edit-status change (brand nudge)
  lastTeamUpdateAt DateTime? // last update by the assignee (stale reminders)
  reminderCount    Int       @default(0)

  addedOn   DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  updates  Update[]
  activity Activity[]

  @@index([assigneeId])
  @@index([brandId])
  @@index([archived])
}

// Editor notes / links thread on a project (old "EDITOR NOTES / LINKS" col)
model Update {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName String
  body       String
  createdAt  DateTime @default(now())

  @@index([projectId])
}

// Field-level history, every change timestamped
model Activity {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorName String
  field     String
  fromValue String?
  toValue   String?
  createdAt DateTime @default(now())

  @@index([projectId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

// Log of daily automation runs (shown on the Automations page)
model AutomationRun {
  id     String   @id @default(cuid())
  source String   // "Scheduled (8:00 AM)" or "Run now by <name>"
  result String   // JSON counts
  ranAt  DateTime @default(now())
}
