// TBM Post Production — replaces the Master / Team / Brand Google Sheets.
// One Project row = one row of the old PROJECTS tab. Team tabs become the
// "My tasks" view (filtered by assignee), brand sheets become the client
// portal (filtered by brand). Nothing is copied between "sheets" any more —
// every view reads the same row, so the old onEdit/onChange sync loop and
// its undo/redo problems simply don't exist here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// TEAM REGISTRY
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   // ADMIN | MANAGER | MEMBER (see lib/constants.ts)
  department   String   // Creative | Editor | Production | Design Lead
  active       Boolean  @default(true) // Inactive = locked out (old "tab locked")
  createdAt    DateTime @default(now())

  googleRefreshToken   String?
  googleAccessToken    String?
  googleTokenExpiresAt DateTime?
  googleCalendarSync   Boolean  @default(false)
  googleCalendarId     String?  @default("primary")

  assigned      Project[]      @relation("Assignee")
  createdTasks  Project[]      @relation("Creator")
  collaborating Project[]      @relation("Collaborators")
  notifications Notification[]
  updates       Update[]
  brands        Brand[]        @relation("BrandMembers") // brand workspaces they belong to
  subtasks      Subtask[]
  favorites     Brand[]        @relation("Favorites")    // starred projects in the sidebar
  goals         Goal[]
  hourlyRate    Float?         @default(0)
  timeEntries   TimeEntry[]
}

// BRAND REGISTRY
model Brand {
  id            String   @id @default(cuid())
  name          String   @unique
  pocName       String?
  pocEmail      String?
  color         String   @default("#5b3fd1")
  repositoryUrl String?  // Brand master Drive repository / assets link
  guidelines    String?  // Style guidelines, onboarding notes for new joiners
  createdAt     DateTime @default(now())

  campaigns Campaign[]
  projects  Project[]
  clients   Client[]
  members   User[]    @relation("BrandMembers") // workspace members (see all its tasks)
  favoritedBy User[]  @relation("Favorites")
  goals     Goal[]
}

// CAMPAIGNS (Brand -> Campaign -> Deliverable)
model Campaign {
  id               String    @id @default(cuid())
  name             String
  brandId          String
  brand            Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  repositoryUrl    String?   // Drive folder for this specific campaign
  internalDeadline DateTime? // Campaign-level master due date (all videos inherit/sync)
  externalDeadline DateTime? // Client contract deadline for campaign
  budget           Float?
  status           String    @default("Active") // Active | Completed | On hold
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  projects Project[]

  @@unique([brandId, name])
  @@index([brandId])
}

// Brand POC logins (replaces the per-brand Google Sheet)
model Client {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  brandId      String
  brand        Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
}

// PROJECTS (one row per deliverable)
model Project {
  id       String  @id @default(cuid())
  code     String  @unique // TBM-001
  title    String
  brandId  String?
  brand    Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  type     String?   // Deliverable type: DVC, Reel, YT Video, etc.
  workType String?   // Work type: Scripting, Assembly, Color/Sound, Run, Pause, etc.
  version  Int       @default(1)
  cost     Float?    // Calculated or assigned video cost
  platform String?
  dept     String  @default("Post Production")

  assigneeId String?
  assignee   User?   @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  priority   String  @default("Medium") // High | Medium | Low

  // Who added the task (team members can add their own tasks), and the
  // people collaborating on it — they can see it and get its comments.
  createdById   String?
  createdBy     User?   @relation("Creator", fields: [createdById], references: [id], onDelete: SetNull)
  collaborators User[]  @relation("Collaborators")

  onHold Boolean @default(false) // board column "On hold"

  externalDeadline DateTime? // client deadline (admins / managers only)
  internalDeadline DateTime? // "Due date": when it should be complete
  startAt          DateTime? // when the work started (date + time)
  endAt            DateTime? // when it's planned to end / be delivered (date + time)

  storageId String?
  storage   Storage? @relation(fields: [storageId], references: [id], onDelete: SetNull)

  briefStage     String @default("Not Started")
  scriptStage    String @default("Not Started")
  preProStage    String @default("Not Started")
  shootStatus    String @default("Not Started")
  editStatus     String @default("Not Started")
  revisionRound  Int    @default(0)
  clientReview   String @default("Pending")
  finalApproval  String @default("Pending")
  deliveryStatus String @default("Not Started")

  notes   String? // internal notes (admin/manager)
  context String? // "context from Sachin" — shown read-only to the assignee

  extDeadlineChanges Int @default(0)
  intDeadlineChanges Int @default(0)

  archived         Boolean   @default(false)
  closedAt         DateTime?
  statusChangedAt  DateTime  @default(now()) // last edit-status change (brand nudge)
  lastTeamUpdateAt DateTime? // last update by the assignee (stale reminders)
  reminderCount    Int       @default(0)

  addedOn   DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  googleCalendarEventId String?

  updates     Update[]
  activity    Activity[]
  subtasks    Subtask[]
  attachments Attachment[]
  timeEntries TimeEntry[]

  @@index([assigneeId])
  @@index([brandId])
  @@index([campaignId])
  @@index([archived])
}

// Time tracking (who worked on which video, for how long, each day)
model TimeEntry {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            DateTime @default(now())
  durationMinutes Int      // minutes worked
  workType        String?  // Run, Pause, Assembly, Revision, Sound, etc.
  notes           String?
  hourlyRate      Float?
  createdAt       DateTime @default(now())

  @@index([projectId])
  @@index([userId, date])
}

// Editor notes / links thread on a project (old "EDITOR NOTES / LINKS" col)
model Update {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName String
  body       String
  createdAt  DateTime @default(now())

  @@index([projectId])
}

// Field-level history, every change timestamped
model Activity {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorName String
  field     String
  fromValue String?
  toValue   String?
  createdAt DateTime @default(now())

  @@index([projectId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

// Log of daily automation runs (shown on the Automations page)
model AutomationRun {
  id     String   @id @default(cuid())
  source String   // "Scheduled (8:00 AM)" or "Run now by <name>"
  result String   // JSON counts
  ranAt  DateTime @default(now())
}

// Where the footage / project files live (hard drive, NAS folder…)
model Storage {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  projects  Project[]
}

// Asana-style subtasks: a checklist of small tasks inside a task
model Subtask {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title      String
  assigneeId String?
  assignee   User?     @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  dueDate    DateTime?
  done       Boolean   @default(false)
  position   Int       @default(0)
  createdAt  DateTime  @default(now())

  googleCalendarEventId String?

  @@index([projectId])
  @@index([assigneeId])
}

// Files on a task: Google Drive files / folders or any link
model Attachment {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  url         String
  mimeType    String?
  iconUrl     String?
  addedByName String
  createdAt   DateTime @default(now())

  @@index([projectId])
}

// Goals (like Asana Goals): what the team is aiming for, with progress
model Goal {
  id        String    @id @default(cuid())
  title     String
  ownerId   String?
  owner     User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  brandId   String?
  brand     Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  dueDate   DateTime?
  progress  Int       @default(0) // 0-100
  status    String    @default("On track") // On track | At risk | Off track | Achieved
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}
