# --- Database (Supabase project for TBM Post Production) ---
# Supabase -> Project Settings -> Database -> Connection string
# DATABASE_URL = pooled (port 6543, add ?pgbouncer=true), DIRECT_URL = direct (port 5432)
DATABASE_URL=""
DIRECT_URL=""

# --- Supabase API & Auth ---
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""

# --- Auth (NextAuth with Google OAuth) ---
