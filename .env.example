# --- Database (Supabase project for TBM Post Production) ---
# Supabase -> Project Settings -> Database -> Connection string
# DATABASE_URL = pooled (port 6543, add ?pgbouncer=true), DIRECT_URL = direct (port 5432)
DATABASE_URL=""
DIRECT_URL=""

# --- Auth (same setup as the Campaign Panel) ---
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
# Google OAuth client. You can reuse the Campaign Panel's client and just add
# this app's redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Email (same SMTP as the Campaign Panel) ---
# Set to "true" to stop all outbound notification emails
# Optional: redirect all outgoing emails to a single address for testing
REDIRECT_ALL_EMAILS_TO="haji.karim@theboredmonkey.com"
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="notifications@theboredmonkey.com"

# Secret for /api/cron/daily (Vercel Cron sends it as a Bearer token)
CRON_SECRET=""

# Public URL used in email links
APP_URL="http://localhost:3000"

# --- One-time import from the Google Sheets (read-only) ---
MASTER_SHEET_ID="1-r9X7E6AIP1wzFKEt_2gM-33FpBUEHoSIPnkOVwa1ws"

# Comma-separated emails that become ADMIN on seed/import (Master sheet owners)
ADMIN_EMAILS="sachin@theboredmonkey.com,jiya.bhagat@theboredmonkey.com"
